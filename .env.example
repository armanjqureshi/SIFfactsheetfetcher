# Settings for running the app on your own computer.
# Copy this file to ".env" (same folder) and change values if needed.

# Run without Manus login or Manus storage. Only use this on your own computer.
LOCAL_MODE=true

# Name shown in the top-right corner of the app.
LOCAL_USER_NAME=Local user

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Matches docker-compose.yml and the SQL in LOCAL_SETUP.md.
DATABASE_URL=mysql://sif:sif@127.0.0.1:3306/sif

# Port the app runs on: http://localhost:3000
PORT=3000

# Folder where downloaded and uploaded PDFs are kept (relative to this project).
# LOCAL_STORAGE_DIR=data/storage
