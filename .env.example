# Settings for running the app without Manus (on your computer or on a host like Railway).
# Copy this file to ".env" (same folder) and change values if needed.

# Run without Manus login or Manus storage.
LOCAL_MODE=true

# Name shown in the top-right corner of the app.
LOCAL_USER_NAME=Local user

# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Matches docker-compose.yml and the SQL in LOCAL_SETUP.md.
DATABASE_URL=mysql://sif:sif@127.0.0.1:3306/sif

# Port the app runs on: http://localhost:3000
PORT=3000

# Folder where downloaded and uploaded PDFs are kept (relative to this project, or an absolute path).
# LOCAL_STORAGE_DIR=data/storage

# --- Only for hosting where other people can reach the app (see RAILWAY.md) ---
# A shared password; turns on the sign-in screen. Required before the app will accept
# connections from other computers.
# APP_PASSWORD=
# Create/update database tables automatically on start-up.
# RUN_MIGRATIONS=true
